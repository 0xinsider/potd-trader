# `potd-trader init` writes ~/.potd-trader/.env for you. This file is the by-hand route for a
# repository checkout: copy to .env, fill in, then chmod 600 .env. A .env next to the code takes
# precedence over the home one. Nothing in this file is ever committed: .env is in .gitignore.

# --- 0xinsider (read-only: the pick) -------------------------------------------------------
# A live Pro key from https://0xinsider.com/developers. This is the only value sent to
# 0xinsider. Sandbox keys (oxi_sk_test_...) cannot read the real pick.
OXINSIDER_API_KEY=oxi_sk_live_replace_me

# --- Polymarket (the account that buys) ----------------------------------------------------
# Your account's signer private key. It signs orders INSIDE this process and never leaves
# your machine. Email/Google login: polymarket.com > Settings > Export private key.
# Wallet login (MetaMask, Rabby): the key in that wallet app.
POLYMARKET_PRIVATE_KEY=0xreplace_me
# Your account wallet address, from the profile menu on polymarket.com. This is the address
# that holds your pUSD and positions. It is NOT the signer address.
POLYMARKET_WALLET_ADDRESS=0xreplace_me

# Optional. Only needed once, for `potd-trader setup`, when your wallet has never traded and
# its trading approvals are missing. polymarket.com > Settings > API Keys > Relayer API Keys.
#POLYMARKET_RELAYER_API_KEY=
#POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Optional. A Polymarket builder code to attribute orders to. Leave unset.
#POLYMARKET_BUILDER_CODE=

# --- The one switch that spends money ------------------------------------------------------
# Anything other than exactly "yes" is a dry run: picks are read, plans are printed, no order.
LIVE=no

# --- Sizing and guards ----------------------------------------------------------------------
# pUSD to spend per pick. Start small.
STAKE_USD=5
# Never buy above this price (probability). 0.925 is the cap 0xinsider's own trader uses.
MAX_PRICE=0.925
# Skip when the live book is this many percent above the price the pick was published at.
MAX_SLIPPAGE_PCT=3
# Never commit more than this per product day across all picks. 0 disables the cap.
DAILY_CAP_USD=25
# Do not buy inside this many minutes before kickoff.
KICKOFF_BUFFER_MINUTES=5
# Only buy picks ranked in this range (1 = the day's top pick).
MIN_RANKS=1
MAX_RANKS=6

# --- Files and cadence ----------------------------------------------------------------------
# Every live order is recorded here so a pick is bought at most once.
#LEDGER_PATH=~/.potd-trader/ledger.json
# `watch` re-reads this often when nothing is scheduled.
WATCH_IDLE_MINUTES=30
